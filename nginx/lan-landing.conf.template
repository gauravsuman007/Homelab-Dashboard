# ===================================================================
# BEGIN lan-landing  (generated by nginx/apply.sh -- do not edit here)
# ===================================================================
# Serves the LAN landing page at http://@HOST_IP@/ .
#
# Generated from nginx/lan-landing.conf.template. Every address below was
# detected on the host at apply time (default route, interface prefix, tailnet,
# hostname); edit the template, not this block, and re-run ./nginx/apply.sh.
#
# WHERE THIS LIVES
# Appended to /data/nginx/custom/http.conf inside the reverse-proxy container.
# NPM's nginx.conf includes only that exact filename at http level, so a new file
# alongside it would be ignored. Re-run ./nginx/apply.sh after an NPM upgrade
# that resets the custom directory.
#
# WHY NOT THE NPM GUI
# NPM's proxy hosts are keyed on domain names, and its "Default Site" setting
# offers only a redirect, a 404, or static HTML -- neither can point a bare IP at
# a container.
#
# WHY server_name AND NOT default_server
# An exact server_name match beats the implicit default (NPM's "You are not
# configured" block in conf.d/default.conf) regardless of include order, so this
# needs no default_server. Leaving the default alone matters: the fallback block
# is what answers Let's Encrypt HTTP-01 challenges for hostnames that have no
# proxy host yet, and what absorbs junk traffic to the public IP. Existing proxy
# hosts are untouched -- none of them is named by an IP.
#
# ACCESS CONTROL
# If ports 80/443 are forwarded from the router, "only the LAN can reach port 80"
# is false, and a Host header is trivially forged -- so an outside request can
# arrive here. The page exposes the internal port map of the whole server and
# links to unauthenticated admin UIs, so the ACL below is what actually keeps it
# internal. It sits in `location /` rather than at server level so nothing else
# in this block is affected.
#
# WHY THE DOCKER BRIDGE RANGES ARE *NOT* ALLOWED
# NPM publishes port 80 over IPv6 through docker's *userland* proxy (ip6tables
# NAT is off by default), which rewrites the peer address. Measured on this host:
# a request to its routable IPv6 address arrives at nginx as the bridge gateway,
# on the IPv4 socket -- so neither $remote_addr nor a v4-only `listen` can tell
# it apart from a container on that bridge. IPv4 is DNAT'd by iptables and does
# preserve the real source.
#
# Consequence: allowing the docker ranges would allow the entire IPv6 internet to
# read this page with a forged Host header. So the list is the LAN and the
# tailnet only, and requests from other containers get 403 -- worth paying, since
# nothing needs to fetch this page from inside a container. (This does not affect
# nginx reaching the backend: proxy_pass is not subject to the client ACL.) None
# of this disables or degrades IPv6 anywhere: the block simply does not add an
# IPv6 listener, and every other vhost keeps its own.
server {
    listen 80;

    # Every name that means "this box", detected at apply time. Anything else --
    # including all proxied domains -- is matched by its own server block.
    server_name @SERVER_NAMES@;

    access_log /data/logs/lan-landing_access.log proxy;
    error_log  /data/logs/lan-landing_error.log warn;

    # NPM's own hardening, kept for parity with the generated hosts.
    include conf.d/include/block-exploits.conf;

    # Left open on purpose: certbot must reach this path if a cert is ever
    # validated against this vhost.
    include conf.d/include/letsencrypt-acme-challenge.conf;

    location / {
@ALLOW_RULES@
        deny all;

        proxy_pass http://@HOST_IP@:@APP_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The page polls /api/apps every 30s; a short read timeout keeps a wedged
        # backend from hanging the tab.
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }
}
# ===================================================================
# END lan-landing
# ===================================================================
